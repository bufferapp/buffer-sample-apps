# Your app client, from https://publish.buffer.com/settings/api
BUFFER_CLIENT_ID=your_client_id
BUFFER_CLIENT_SECRET=your_client_secret

# Can be changed to your own REDIRECT_URI. Must match what you registered, character for character
REDIRECT_URI=https://localhost:3000/callback

#PORT your app is running on locally. Can be changed to match the details in your custom REDIRECT_URI.
PORT=3000

# Encrypts the session cookie; 32 characters minimum. Leave it empty locally and
# the app generates one into .session-key on first boot. Required in production:
#   openssl rand -hex 32
SESSION_SECRET=
